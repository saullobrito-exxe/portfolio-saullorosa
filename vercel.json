{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/portfolio",
      "destination": "/savedPortfolio.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
